DATABASE_URL=postgres://reelate:reelate_dev@localhost:5434/reelate
DATABASE_URL_TEST=postgres://reelate:reelate_dev@localhost:5434/reelate_test
AUTH_SECRET=change-me
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Python motorun storage dizininin mutlak yolu (worker'ın video yazdığı yer)
STORAGE_ROOT=/absolute/path/to/MoneyPrinterTurbo/storage

# Python (FastAPI) backend base URL for synchronous calls like voice preview
PYTHON_API_URL=http://localhost:8080

# Geri bildirim formu (/dashboard/feedback) — Gmail SMTP ile gönderilir.
# SMTP_APP_PASSWORD: Google Hesabı → Güvenlik → 2 Adımlı Doğrulama → Uygulama şifreleri
SMTP_USER=
SMTP_APP_PASSWORD=
# Boş bırakılırsa info@reelate.org
FEEDBACK_TO=

# Google Analytics 4 (kurulum: deploy/ANALYTICS.md)
# Prod measurement ID kodda sabit: src/lib/analytics/config.ts. Bu env yalnızca
# yerel doğrulama içindir: localhost'ta da yükler ve debug_mode açar.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Measurement Protocol API secret (Stripe webhook'undan server-side purchase)
GA_API_SECRET=
